{
  "name": "glass-dracula",
  "displayName": "Glass Dracula",
  "description": "Custom Dracula themes by BennyWu: Dark Vivid Black and Light Vivid White.",
  "version": "0.3.4",
  "publisher": "BennyWu",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dracula",
    "dark",
    "light",
    "color-theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aniu456/glass-dracula-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Aniu456/glass-dracula-vscode/issues"
  },
  "homepage": "https://github.com/Aniu456/glass-dracula-vscode#readme",
  "scripts": {
    "build:themes": "node scripts/convert-zed-to-vscode.js",
    "package": "npm run build:themes && vsce package",
    "publish:marketplace": "npm run build:themes && vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dracula Dark Vivid Black",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-dark-vivid-black-color-theme.json"
      },
      {
        "label": "Dracula Light Vivid White",
        "uiTheme": "vs",
        "path": "./themes/dracula-light-vivid-white-color-theme.json"
      }
    ]
  },
  "files": [
    "themes/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.png"
  ],
  "galleryBanner": {
    "color": "#0B0B0E",
    "theme": "dark"
  }
}
