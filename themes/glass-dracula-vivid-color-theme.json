{
  "$schema": "vscode://schemas/color-theme",
  "name": "Glass Dracula Vivid",
  "type": "dark",
  "colors": {
    "editor.background": "#08090900",
    "editor.foreground": "#abb2bf",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#abb2bf",
    "editor.lineHighlightBackground": "#08090900",
    "editorBracketMatch.background": "#abb2bf30",
    "editor.wordHighlightBackground": "#555a6345",
    "editor.wordHighlightStrongBackground": "#555a6345",
    "editor.findMatchHighlightBackground": "#d19a6644",
    "editorIndentGuide.background": "#212121",
    "titleBar.activeBackground": "#080909DD",
    "titleBar.inactiveBackground": "#080909DD",
    "statusBar.background": "#080909DD",
    "statusBar.foreground": "#abb2bf",
    "sideBar.background": "#08090900",
    "sideBar.foreground": "#abb2bf",
    "sideBarSectionHeader.background": "#080909",
    "editorGroupHeader.tabsBackground": "#08090900",
    "tab.activeBackground": "#080909",
    "tab.inactiveBackground": "#08090900",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#abb2bf",
    "editorGroup.border": "#212121",
    "sideBar.border": "#212121",
    "panel.border": "#212121",
    "titleBar.border": "#212121",
    "statusBar.border": "#212121",
    "tab.border": "#212121",
    "activityBar.background": "#080909DD",
    "activityBar.foreground": "#abb2bf",
    "panel.background": "#08090900",
    "scrollbarSlider.background": "#4e566680",
    "scrollbarSlider.hoverBackground": "#5a6375",
    "scrollbarSlider.activeBackground": "#5a6375",
    "editor.selectionBackground": "#67769660",
    "editor.selectionHighlightBackground": "#67769640",
    "list.activeSelectionBackground": "#2c313a",
    "list.hoverBackground": "#2c313a",
    "list.focusBackground": "#2c313a",
    "input.background": "#080909",
    "input.border": "#212121",
    "dropdown.background": "#080909",
    "dropdown.border": "#212121",
    "terminal.background": "#08090900",
    "terminal.ansiBlack": "#3f4451",
    "terminal.ansiBrightBlack": "#4f5666",
    "terminal.ansiRed": "#e05561",
    "terminal.ansiBrightRed": "#ff616e",
    "terminal.ansiGreen": "#8cc265",
    "terminal.ansiBrightGreen": "#a5e075",
    "terminal.ansiYellow": "#d18f52",
    "terminal.ansiBrightYellow": "#f0a45d",
    "terminal.ansiBlue": "#4aa5f0",
    "terminal.ansiBrightBlue": "#4dc4ff",
    "terminal.ansiMagenta": "#c162de",
    "terminal.ansiBrightMagenta": "#de73ff",
    "terminal.ansiCyan": "#42b3c2",
    "terminal.ansiBrightCyan": "#4cd1e0",
    "terminal.ansiWhite": "#d7dae0",
    "terminal.ansiBrightWhite": "#e6e6e6",
    "editorError.foreground": "#c24038",
    "editorWarning.foreground": "#d19a66",
    "editorInfo.foreground": "#4aa5f0",
    "gitDecoration.addedResourceForeground": "#a5e075",
    "gitDecoration.modifiedResourceForeground": "#e5c07b",
    "gitDecoration.deletedResourceForeground": "#ff616e",
    "gitDecoration.ignoredResourceForeground": "#636b78",
    "minimap.background": "#08090900",
    "breadcrumb.foreground": "#abb2bf",
    "breadcrumb.background": "#08090900",
    "editorWidget.background": "#080909",
    "editorWidget.border": "#212121"
  },
  "tokenColors": [
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#9893c6"
      }
    },
    {
      "name": "comment.doc",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "embedded",
      "scope": [
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f9d338",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fe9d5c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "enum",
      "scope": [
        "entity.name.type.enum",
        "support.type.enum"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#89ff7d"
      }
    },
    {
      "name": "hint",
      "scope": [
        "markup.hint"
      ],
      "settings": {
        "foreground": "#a08deb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "markup.underline.link",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link.url"
      ],
      "settings": {
        "foreground": "#32c1ff"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "predictive",
      "scope": [
        "markup.prediction"
      ],
      "settings": {
        "foreground": "#e5e5e5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "preproc",
      "scope": [
        "keyword.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#9893c6"
      }
    },
    {
      "name": "primary",
      "scope": [
        "source"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "entity.other.attribute-name.css"
      ],
      "settings": {
        "foreground": "#32c1ff"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "punctuation.bracket",
      "scope": [
        "punctuation.definition.bracket",
        "meta.brace",
        "punctuation.brackets"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "punctuation.delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#32c1ff"
      }
    },
    {
      "name": "punctuation.special",
      "scope": [
        "punctuation.special",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#f9d338"
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f37567"
      }
    },
    {
      "name": "string.special",
      "scope": [
        "string.special",
        "string.template"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#fe5c9d"
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#89ff7d"
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#32c1ff"
      }
    },
    {
      "name": "type.interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#32c1ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "type.super",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#32c1ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "variable.member",
      "scope": [
        "variable.other.member",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#e5e5e5"
      }
    },
    {
      "name": "variable.parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#fe9d5c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#a08deb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "variant",
      "scope": [
        "entity.name.type.variant",
        "support.type.variant"
      ],
      "settings": {
        "foreground": "#a08deb"
      }
    }
  ]
}